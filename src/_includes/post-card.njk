{#- Archive-style card for `post`. The title link stretches over the whole card; topic badges sit above it. -#}
<div class="group relative mb-12">
  <div class="border-l-2 border-gray-100 pl-6 group-hover:border-black transition-colors duration-300">
    <div class="flex flex-wrap items-center gap-2.5 mb-2">
      <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">
        {{ post.date | dateDisplay if post.date else "" }}
      </span>
      {% if post.data.language %}
      <span class="text-gray-300">•</span>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wider {% if post.data.language == 'italian' %}bg-emerald-50 text-emerald-700 border border-emerald-100{% else %}bg-purple-50 text-purple-700 border border-purple-100{% endif %}">
        {{ post.data.language }}
      </span>
      {% endif %}
      {% topicBadges post.data.tags %}
    </div>
    <h3 class="text-2xl font-bold mb-3 group-hover:text-purple-700 transition-colors">
      <a href="{{ post.url }}" class="after:absolute after:inset-0">{{ post.data.title }}</a>
    </h3>
    <p class="text-gray-500 mb-4 leading-relaxed">
      {{ post.data.description }}
    </p>
    <div class="text-sm font-bold text-gray-900 uppercase tracking-wide">
      Read full post &rarr;
    </div>
  </div>
</div>
