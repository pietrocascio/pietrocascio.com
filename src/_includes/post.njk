---
layout: base.njk
---

<article>
  {{ content | safe }}

  {% set previousPost = collections.post | getPreviousCollectionItem(page) %}
  {% set nextPost = collections.post | getNextCollectionItem(page) %}

  <nav class="mt-16 pt-8 border-t border-gray-100" aria-label="Blog post navigation">
    <div class="flex justify-between items-center mb-6">
      <a href="/articles/" class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-gray-500 hover:text-black transition-colors">
        &larr; All Articles
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {% if previousPost %}
      <a href="{{ previousPost.url }}" class="group block p-5 rounded-xl border border-gray-100 hover:border-gray-300 hover:shadow-sm transition-all duration-200 bg-white">
        <div class="flex items-center justify-between mb-2">
          <span class="block text-xs font-bold uppercase tracking-wider text-gray-400 group-hover:text-black transition-colors">
            &larr; Older Post
          </span>
          {% if previousPost.data.language %}
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider {% if previousPost.data.language == 'italian' %}bg-emerald-50 text-emerald-700 border border-emerald-100{% else %}bg-purple-50 text-purple-700 border border-purple-100{% endif %}">
            {{ previousPost.data.language }}
          </span>
          {% endif %}
        </div>
        <span class="block text-base font-bold text-gray-900 group-hover:text-purple-700 transition-colors">
          {{ previousPost.data.title }}
        </span>
      </a>
      {% else %}
      <div class="hidden md:block"></div>
      {% endif %}

      {% if nextPost %}
      <a href="{{ nextPost.url }}" class="group block p-5 rounded-xl border border-gray-100 hover:border-gray-300 hover:shadow-sm transition-all duration-200 bg-white md:text-right">
        <div class="flex items-center justify-between md:justify-end md:space-x-2 mb-2">
          {% if nextPost.data.language %}
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider {% if nextPost.data.language == 'italian' %}bg-emerald-50 text-emerald-700 border border-emerald-100{% else %}bg-purple-50 text-purple-700 border border-purple-100{% endif %}">
            {{ nextPost.data.language }}
          </span>
          {% endif %}
          <span class="block text-xs font-bold uppercase tracking-wider text-gray-400 group-hover:text-black transition-colors">
            Newer Post &rarr;
          </span>
        </div>
        <span class="block text-base font-bold text-gray-900 group-hover:text-purple-700 transition-colors">
          {{ nextPost.data.title }}
        </span>
      </a>
      {% endif %}
    </div>
  </nav>
</article>
