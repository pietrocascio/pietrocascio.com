<!DOCTYPE html>
<html lang="{% if language == 'italian' %}it{% else %}en{% endif %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | Pietro Cascio</title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <meta name="description" content="{{ description }}">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <script src="css/styles.css"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap"
        rel="stylesheet">
  <script>
    tailwind.config = {theme: {extend: {fontFamily: {sans: ['Inter', 'sans-serif'],}}}}
  </script>
</head>
<body class="bg-white text-gray-900 antialiased font-sans">

<div class="max-w-3xl mx-auto px-6 py-12 md:py-20">

  <nav
      class="flex flex-col md:flex-row justify-between items-start md:items-center mb-16 space-y-4 md:space-y-0">
    <div class="font-bold tracking-tight text-lg">
      <a href="/" class="hover:text-gray-600 transition-colors">PIETRO CASCIO</a>
    </div>

    <div
        class="flex flex-col md:flex-row items-start md:items-center space-y-4 md:space-y-0 md:space-x-8 text-m font-medium">
      <a href="/articles/"
         class="text-black hover:text-[#F90093] transition-colors font-bold uppercase tracking-widest">
        Blog
      </a>

      <div
          class="flex items-center space-x-4 bg-purple-50 px-4 py-2 rounded-full border border-purple-100">
        <a href="https://www.linkedin.com/in/pietrocascio/" target="_blank"
           class="text-gray-600 hover:text-[#F90093] transition-colors flex items-center whitespace-nowrap">
          <img src="/images/linkedin/LI-In-Bug.png" alt="LinkedIn Logo" class="w-5 mr-1">
          LinkedIn
        </a>
        <a href="https://app.pluralsight.com/profile/author/pietro-cascio" target="_blank"
           class="text-gray-600 hover:text-[#F90093] transition-colors flex items-center whitespace-nowrap">
          <img src="/images/pluralsight/PS-mark-color-fill.png" alt="Pluralsight Logo"
               class="w-5 mr-1">
          Pluralsight
        </a>
        <a href="https://www.credly.com/users/pietro-cascio/badges#credly" target="_blank"
           class="text-gray-600 hover:text-orange-600 transition-colors flex items-center whitespace-nowrap">
          <img src="/images/credly/credly-logo.png" alt="Credly Logo"
               class="w-5 mr-1">
          Credly
        </a>
      </div>
    </div>
  </nav>

  <main>
    {{ content | safe }}
  </main>

  <footer class="pt-10 border-t border-gray-100 text-center text-xs text-gray-400 mt-24">
    &copy; 2026 Pietro Cascio. No tracking. No cookies. Just HTML.
  </footer>

</div>
</body>
</html>